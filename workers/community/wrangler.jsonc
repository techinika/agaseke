{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agaseke-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "agaseke4creators"
  }
}

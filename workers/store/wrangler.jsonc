{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agaseke-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "agaseke4creators"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS_BUCKET",
      "bucket_name": "agaseke-assets"
    }
  ]
}
